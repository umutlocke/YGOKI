# Keep installation data, personal decks, and generated results local.
# New files on the top level must be allowed explicitly; otherwise /* hides them.
/*
!/.gitignore
!/LICENSE
!/THIRD-PARTY.md
!/bootstrap.ps1
!/revisionen.json
!/pyproject.toml
!/README.md
!/work/
!/outputs/
!/.github/
!/tests/

# Python- und pytest-Artefakte
__pycache__/
*.pyc
.pytest_cache/

/work/*
!/work/*.py
!/work/routen/
/work/routen/*
!/work/routen/*.json
!/work/tcg_freigaben.json
!/work/kartenrollen_manuell.json
!/work/karten_ausschluss.json
!/work/testdecks/
/work/testdecks/*
!/work/testdecks/*.ydk
!/work/native/
/work/native/*
!/work/native/App.cs
!/work/native/CardImages.cs
!/work/native/SpectatorView.cs
!/work/native/TrainingView.cs
!/work/native/TournamentView.cs
!/work/native/MainWindow.xaml
!/work/native/build.ps1

/outputs/*
!/outputs/*.cmd
!/outputs/*.ps1
!/outputs/Prototyp.md
!/outputs/KI-Training-Anleitung.md
!/outputs/Windows-Build-Pruefung.md
!/outputs/pre-push-beispiel.sh
