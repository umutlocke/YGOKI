<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YGO KI APP" Width="1370" Height="900" MinWidth="950" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#10131C" Foreground="#EFF2FA"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#191F2D"/>
    <SolidColorBrush x:Key="Line" Color="#344055"/>
    <SolidColorBrush x:Key="Muted" Color="#ABB6CC"/>
    <SolidColorBrush x:Key="Accent" Color="#B8C8FF"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EFF2FA"/>
      <Setter Property="Background" Value="#263148"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A5B8FF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".76"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#141C35"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#EFF2FA"/><Setter Property="Background" Value="#121826"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="7,5"/>
      <Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#E3EAFD"/><Setter Property="Foreground" Value="#172039"/>
      <Setter Property="BorderBrush" Value="#62769D"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="7,3"/>
    </Style>
    <Style TargetType="ListView">
      <Setter Property="Background" Value="#151B28"/><Setter Property="Foreground" Value="#EFF2FA"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Foreground" Value="#EFF2FA"/><Setter Property="Padding" Value="4,5"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="#151B28" BorderBrush="#293248" BorderThickness="0,0,0,1">
              <GridViewRowPresenter Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    Content="{TemplateBinding Content}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#202A3E"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#34466C"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="#242F46"/><Setter Property="Foreground" Value="#D7E1FC"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="6"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#151B28"/><Setter Property="Foreground" Value="#EFF2FA"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#EFF2FA"/><Setter Property="Padding" Value="7,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="#151B28"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#34466C"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
    </Style>
  </Window.Resources>
  <Border Background="#10131C" Padding="24,16,24,16">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14" LastChildFill="False">
      <TextBlock Text="YGO KI APP" FontWeight="Bold" FontSize="24" Margin="0,0,30,0" VerticalAlignment="Center"/>
      <Button x:Name="ShowEditor" Content="Deckeditor" Style="{StaticResource PrimaryButton}"/>
      <Button x:Name="ShowComparison" Content="Deckvergleich"/>
      <TextBlock DockPanel.Dock="Right" Text="Lokal" Foreground="#8FDEBB" VerticalAlignment="Center" Margin="9,0,0,0"/>
    </DockPanel>
    <Grid Grid.Row="1" x:Name="EditorPage">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <ComboBox x:Name="Library" Width="255" Margin="0,0,8,0" AutomationProperties.Name="Deck öffnen"/>
          <Button x:Name="NewDeck" Content="Neues Deck"/>
          <Button x:Name="ImportDeck" Content=".ydk importieren"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="ExportYdk" Content="YDK exportieren"/>
          <Button x:Name="ExportTxt" Content="TXT exportieren"/>
          <Button x:Name="SaveDeck" Content="Deck speichern" Style="{StaticResource PrimaryButton}" Margin="0"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Panel}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel>
                <TextBlock Text="Deckliste" Style="{StaticResource SectionTitle}" Margin="0,3,13,0"/>
                <TextBox x:Name="DeckName" MaxLength="80" AutomationProperties.Name="Deckname"/>
              </DockPanel>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,9">
                <Button x:Name="MainZone" Content="Main Deck"/>
                <Button x:Name="ExtraZone" Content="Extra Deck"/>
                <Button x:Name="SideZone" Content="Side Deck"/>
                <TextBlock x:Name="LockCount" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <ListView Grid.Row="2" x:Name="DeckCards" AutomationProperties.Name="Karten im Deck">
                <ListView.View><GridView>
                  <GridViewColumn Header="Karte" Width="250" DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn Header="Typ" Width="111" DisplayMemberBinding="{Binding Type}"/>
                  <GridViewColumn Header="Menge" Width="61" DisplayMemberBinding="{Binding Quantity}"/>
                  <GridViewColumn Header="Sperre" Width="75" DisplayMemberBinding="{Binding LockLabel}"/>
                </GridView></ListView.View>
              </ListView>
              <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                <Button x:Name="DeckMinus" Content="−" AutomationProperties.Name="Exemplar entfernen"/>
                <Button x:Name="DeckPlus" Content="+" AutomationProperties.Name="Exemplar hinzufügen"/>
                <Button x:Name="ToggleLock" Content="Karte sperren"/>
                <ComboBox x:Name="MoveZone" Width="118" Margin="6,0,6,0" AutomationProperties.Name="Zielbereich"/>
                <Button x:Name="MoveCard" Content="Verschieben"/>
              </WrapPanel>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource Panel}">
            <StackPanel>
              <DockPanel LastChildFill="False">
                <TextBlock Text="Formatprüfung" Style="{StaticResource SectionTitle}" Margin="0,4,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <ComboBox x:Name="EditorFormat" Width="102" Margin="0,0,6,0" AutomationProperties.Name="Format"/>
                  <ComboBox x:Name="EditorBanlist" Width="102" AutomationProperties.Name="Banliste"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Margin="0,6,0,5">
                <Button DockPanel.Dock="Right" x:Name="ShowSuggestions" Content="Deck verbessern" Margin="8,0,0,0"/>
                <TextBlock x:Name="CheckSummary" Text="Deckliste wird geladen…" Foreground="{StaticResource Accent}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <ScrollViewer MaxHeight="98" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="CheckDetails" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>
        <Border Grid.Column="2" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Kartenkatalog" Style="{StaticResource SectionTitle}"/>
            <TextBox Grid.Row="1" x:Name="CardQuery" MaxLength="120" ToolTip="Kartenname oder Passcode" AutomationProperties.Name="Karte suchen"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,9">
              <ComboBox x:Name="CardKind" Width="112" Margin="0,0,7,0" AutomationProperties.Name="Kartentyp"/>
              <ComboBox x:Name="AddTarget" Width="142" Margin="0,0,7,0" AutomationProperties.Name="Karte hinzufügen zu"/>
              <Button x:Name="AddCard" Content="Hinzufügen" Margin="0"/>
            </StackPanel>
            <ListView Grid.Row="3" x:Name="Catalogue" AutomationProperties.Name="Gefundene Karten">
              <ListView.View><GridView>
                <GridViewColumn Header="Karte" Width="229" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Typ" Width="91" DisplayMemberBinding="{Binding Type}"/>
                <GridViewColumn Header="Status" Width="130" DisplayMemberBinding="{Binding Availability}"/>
              </GridView></ListView.View>
            </ListView>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="PrevCards" Content="Zurück"/>
              <Button x:Name="NextCards" Content="Weiter"/>
              <TextBlock x:Name="CardCount" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" x:Name="ComparisonPage" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Testlauf einrichten" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Original A" Style="{StaticResource LabelText}"/>
            <ComboBox x:Name="OriginalDeck" Margin="0,0,0,9" AutomationProperties.Name="Original A"/>
            <TextBlock Text="Variante B" Style="{StaticResource LabelText}"/>
            <ComboBox x:Name="VariantDeck" Margin="0,0,0,9" AutomationProperties.Name="Variante B"/>
            <TextBlock Text="Vergleichsgegner" Style="{StaticResource LabelText}"/>
            <ListBox x:Name="Opponents" SelectionMode="Multiple" Height="130" Margin="0,0,0,9" AutomationProperties.Name="Vergleichsgegner"/>
            <Grid Margin="0,0,0,9">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Format" Style="{StaticResource LabelText}"/><ComboBox x:Name="CompareFormat"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Banliste" Style="{StaticResource LabelText}"/><ComboBox x:Name="CompareBanlist"/></StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Blöcke je Gegner" Style="{StaticResource LabelText}"/><TextBox x:Name="Blocks" Text="10"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Seed" Style="{StaticResource LabelText}"/><TextBox x:Name="Seed" Text="1731"/></StackPanel>
            </Grid>
            <TextBlock x:Name="PlannedGames" Foreground="{StaticResource Muted}" Margin="0,9,0,9"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="StartComparison" Content="Vergleich starten" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="CancelComparison" Content="Abbrechen" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Auswertung" Style="{StaticResource SectionTitle}"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ExportReport" Content="Bericht exportieren" IsEnabled="False"/>
            <Button x:Name="ExportGames" Content="Einzelspiele exportieren" IsEnabled="False"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock x:Name="ComparisonProgress" Text="Wähle Original, Variante und mindestens einen Vergleichsgegner."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              <UniformGrid x:Name="Metrics" Columns="3" Visibility="Collapsed" Margin="0,15,0,15">
                <Border Style="{StaticResource Panel}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Siegquote A" Style="{StaticResource LabelText}"/><TextBlock x:Name="WinRateA" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Siegquote B" Style="{StaticResource LabelText}"/><TextBlock x:Name="WinRateB" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Differenz B − A" Style="{StaticResource LabelText}"/><TextBlock x:Name="Difference" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
              </UniformGrid>
              <TextBlock x:Name="ComparisonDetails" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="21"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="Status" Margin="0,10,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
  </Grid>
  </Border>
</Window>
