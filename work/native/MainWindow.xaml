<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YGO KI APP" Width="1370" Height="900" MinWidth="950" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#10131C" Foreground="#EFF2FA"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#191F2D"/>
    <SolidColorBrush x:Key="Line" Color="#344055"/>
    <SolidColorBrush x:Key="Muted" Color="#ABB6CC"/>
    <SolidColorBrush x:Key="Accent" Color="#B8C8FF"/>
    <DataTemplate x:Key="CardThumbnail">
      <Border Width="26" Height="38" HorizontalAlignment="Center" Background="#263148"
              ToolTip="Doppelklick für Kartenbild">
        <Grid>
          <TextBlock Text="–" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{StaticResource Muted}"/>
          <Image Source="{Binding Picture}" Stretch="Uniform"/>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="WatchTile">
      <Border Margin="2" Padding="3" MinHeight="49" Background="#121826" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="4" ToolTip="{Binding Name}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image Source="{Binding Art.Picture}" Width="28" Height="41" Stretch="Uniform"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxHeight="37" FontSize="11"/>
            <TextBlock Text="{Binding Stats}" Foreground="{StaticResource Muted}" FontSize="10"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="WatchHandCard">
      <Border Width="120" Height="48" Margin="0,0,4,0" Padding="3" Background="#121826"
              BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" ToolTip="{Binding Name}">
        <DockPanel>
          <Image Width="26" Height="38" Margin="0,0,4,0" Stretch="Uniform" Source="{Binding Art.Picture}"/>
          <TextBlock Text="{Binding Name}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
    </DataTemplate>
    <Style x:Key="WatchPhaseChip" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Background" Value="#20283A"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>
    <Style x:Key="WatchPhaseActive" TargetType="TextBlock" BasedOn="{StaticResource WatchPhaseChip}">
      <Setter Property="Foreground" Value="#141C35"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <ItemsPanelTemplate x:Key="HandSlots"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="MonsterSlots"><UniformGrid Columns="7"/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="SpellSlots"><UniformGrid Columns="8"/></ItemsPanelTemplate>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EFF2FA"/>
      <Setter Property="Background" Value="#263148"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A5B8FF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".76"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#141C35"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#EFF2FA"/><Setter Property="Background" Value="#121826"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="7,5"/>
      <Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#E3EAFD"/><Setter Property="Foreground" Value="#172039"/>
      <Setter Property="BorderBrush" Value="#62769D"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="7,3"/>
    </Style>
    <Style TargetType="ListView">
      <Setter Property="Background" Value="#151B28"/><Setter Property="Foreground" Value="#EFF2FA"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Foreground" Value="#EFF2FA"/><Setter Property="Padding" Value="4,5"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="#151B28" BorderBrush="#293248" BorderThickness="0,0,0,1">
              <GridViewRowPresenter Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    Content="{TemplateBinding Content}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#202A3E"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#34466C"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="#242F46"/><Setter Property="Foreground" Value="#D7E1FC"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="6"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#151B28"/><Setter Property="Foreground" Value="#EFF2FA"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#EFF2FA"/><Setter Property="Padding" Value="7,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="#151B28"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#34466C"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
    </Style>
  </Window.Resources>
  <Border Background="#10131C" Padding="24,16,24,16">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14" LastChildFill="False">
      <TextBlock Text="YGO KI APP" FontWeight="Bold" FontSize="24" Margin="0,0,30,0" VerticalAlignment="Center"/>
      <Button x:Name="ShowEditor" Content="Deckeditor" Style="{StaticResource PrimaryButton}"/>
      <Button x:Name="ShowComparison" Content="Deckvergleich"/>
      <Button x:Name="ShowWatch" Content="Zuschauen"/>
      <Button x:Name="ShowTraining" Content="KI-Training"/>
      <Button x:Name="ShowTournament" Content="Turnier"/>
      <TextBlock DockPanel.Dock="Right" Text="Lokal" Foreground="#8FDEBB" VerticalAlignment="Center" Margin="9,0,0,0"/>
    </DockPanel>
    <Grid Grid.Row="1" x:Name="EditorPage">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <ComboBox x:Name="Library" Width="255" Margin="0,0,8,0" AutomationProperties.Name="Deck öffnen"/>
          <Button x:Name="NewDeck" Content="Neues Deck"/>
          <Button x:Name="ImportDeck" Content=".ydk importieren"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="ExportYdk" Content="YDK exportieren"/>
          <Button x:Name="ExportTxt" Content="TXT exportieren"/>
          <Button x:Name="SaveDeck" Content="Deck speichern" Style="{StaticResource PrimaryButton}" Margin="0"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Panel}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel>
                <TextBlock Text="Deckliste" Style="{StaticResource SectionTitle}" Margin="0,3,13,0"/>
                <TextBox x:Name="DeckName" MaxLength="80" AutomationProperties.Name="Deckname"/>
              </DockPanel>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,9">
                <Button x:Name="MainZone" Content="Main Deck"/>
                <Button x:Name="ExtraZone" Content="Extra Deck"/>
                <Button x:Name="SideZone" Content="Side Deck"/>
                <TextBlock x:Name="LockCount" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <ListView Grid.Row="2" x:Name="DeckCards" AutomationProperties.Name="Karten im Deck">
                <ListView.View><GridView>
                  <GridViewColumn Header="Bild" Width="43" CellTemplate="{StaticResource CardThumbnail}"/>
                  <GridViewColumn Header="Karte" Width="250" DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn Header="Typ" Width="111" DisplayMemberBinding="{Binding Type}"/>
                  <GridViewColumn Header="Menge" Width="61" DisplayMemberBinding="{Binding Quantity}"/>
                  <GridViewColumn Header="Sperre" Width="75" DisplayMemberBinding="{Binding LockLabel}"/>
                  <GridViewColumn Header="Rolle" Width="170">
                    <GridViewColumn.CellTemplate><DataTemplate>
                      <TextBlock Text="{Binding Role}" ToolTip="{Binding RoleReason}"/>
                    </DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Starthand 5 / 6" Width="110" DisplayMemberBinding="{Binding Starthand}"/>
                </GridView></ListView.View>
              </ListView>
              <StackPanel Grid.Row="3">
              <TextBlock x:Name="RoleSummary" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                         ToolTip="Starthand 5 / 6: Chance, mindestens ein Exemplar unter den ersten 5 (du beginnst) bzw. 6 Karten zu haben. ★ = Kernkarte, ⇄ = laut Training austauschbar."/>
              <WrapPanel Margin="0,10,0,0">
                <Button x:Name="DeckMinus" Content="−" AutomationProperties.Name="Exemplar entfernen"/>
                <Button x:Name="DeckPlus" Content="+" AutomationProperties.Name="Exemplar hinzufügen"/>
                <Button x:Name="ToggleLock" Content="Karte sperren"/>
                <ComboBox x:Name="MoveZone" Width="118" Margin="6,0,6,0" AutomationProperties.Name="Zielbereich"/>
                <Button x:Name="MoveCard" Content="Verschieben"/>
              </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource Panel}">
            <StackPanel>
              <DockPanel LastChildFill="False">
                <TextBlock Text="Formatprüfung" Style="{StaticResource SectionTitle}" Margin="0,4,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <ComboBox x:Name="EditorFormat" Width="102" Margin="0,0,6,0" AutomationProperties.Name="Format"/>
                  <ComboBox x:Name="EditorBanlist" Width="102" AutomationProperties.Name="Banliste"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Margin="0,6,0,5">
                <Button DockPanel.Dock="Right" x:Name="ShowSuggestions" Content="Deck verbessern" Margin="8,0,0,0"/>
                <TextBlock x:Name="CheckSummary" Text="Deckliste wird geladen…" Foreground="{StaticResource Accent}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <ScrollViewer MaxHeight="98" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="CheckDetails" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>
        <Border Grid.Column="2" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Kartenkatalog" Style="{StaticResource SectionTitle}"/>
            <TextBox Grid.Row="1" x:Name="CardQuery" MaxLength="120" ToolTip="Kartenname oder Passcode" AutomationProperties.Name="Karte suchen"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,9">
              <ComboBox x:Name="CardKind" Width="112" Margin="0,0,7,0" AutomationProperties.Name="Kartentyp"/>
              <ComboBox x:Name="AddTarget" Width="142" Margin="0,0,7,0" AutomationProperties.Name="Karte hinzufügen zu"/>
              <Button x:Name="AddCard" Content="Hinzufügen" Margin="0"/>
            </StackPanel>
            <ListView Grid.Row="3" x:Name="Catalogue" AutomationProperties.Name="Gefundene Karten">
              <ListView.View><GridView>
                <GridViewColumn Header="Bild" Width="43" CellTemplate="{StaticResource CardThumbnail}"/>
                <GridViewColumn Header="Karte" Width="204" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Typ" Width="104" DisplayMemberBinding="{Binding Type}"/>
                <GridViewColumn Header="Status" Width="118" DisplayMemberBinding="{Binding Availability}"/>
              </GridView></ListView.View>
            </ListView>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="PrevCards" Content="Zurück"/>
              <Button x:Name="NextCards" Content="Weiter"/>
              <TextBlock x:Name="CardCount" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" x:Name="ComparisonPage" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Testlauf einrichten" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Original A" Style="{StaticResource LabelText}"/>
            <ComboBox x:Name="OriginalDeck" Margin="0,0,0,9" AutomationProperties.Name="Original A"/>
            <TextBlock Text="Variante B" Style="{StaticResource LabelText}"/>
            <ComboBox x:Name="VariantDeck" Margin="0,0,0,9" AutomationProperties.Name="Variante B"/>
            <TextBlock Text="Vergleichsgegner" Style="{StaticResource LabelText}"/>
            <ListBox x:Name="Opponents" SelectionMode="Multiple" Height="130" Margin="0,0,0,9" AutomationProperties.Name="Vergleichsgegner"/>
            <Grid Margin="0,0,0,9">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Format" Style="{StaticResource LabelText}"/><ComboBox x:Name="CompareFormat"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Banliste" Style="{StaticResource LabelText}"/><ComboBox x:Name="CompareBanlist"/></StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Blöcke je Gegner" Style="{StaticResource LabelText}"/><TextBox x:Name="Blocks" Text="10"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Seed" Style="{StaticResource LabelText}"/><TextBox x:Name="Seed" Text="1731"/></StackPanel>
            </Grid>
            <TextBlock x:Name="PlannedGames" Foreground="{StaticResource Muted}" Margin="0,9,0,9"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="StartComparison" Content="Vergleich starten" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="CancelComparison" Content="Abbrechen" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Auswertung" Style="{StaticResource SectionTitle}"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ExportReport" Content="Bericht exportieren" IsEnabled="False"/>
            <Button x:Name="ExportGames" Content="Einzelspiele exportieren" IsEnabled="False"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock x:Name="ComparisonProgress" Text="Wähle Original, Variante und mindestens einen Vergleichsgegner."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              <UniformGrid x:Name="Metrics" Columns="3" Visibility="Collapsed" Margin="0,15,0,15">
                <Border Style="{StaticResource Panel}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Siegquote A" Style="{StaticResource LabelText}"/><TextBlock x:Name="WinRateA" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Siegquote B" Style="{StaticResource LabelText}"/><TextBlock x:Name="WinRateB" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Differenz B − A" Style="{StaticResource LabelText}"/><TextBlock x:Name="Difference" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
              </UniformGrid>
              <TextBlock x:Name="ComparisonDetails" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="21"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="1" x:Name="WatchPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,10,0"><TextBlock Text="Deck A · beginnt" Style="{StaticResource LabelText}"/><ComboBox x:Name="WatchLeft" Width="212"/></StackPanel>
            <StackPanel Margin="0,0,10,0"><TextBlock Text="Deck B" Style="{StaticResource LabelText}"/><ComboBox x:Name="WatchRight" Width="212"/></StackPanel>
            <StackPanel Margin="0,0,10,0"><TextBlock Text="Format" Style="{StaticResource LabelText}"/><ComboBox x:Name="WatchFormat" Width="103"/></StackPanel>
            <StackPanel Margin="0,0,10,0"><TextBlock Text="Tempo" Style="{StaticResource LabelText}"/><ComboBox x:Name="WatchSpeed" Width="94"/></StackPanel>
          </WrapPanel>
          <WrapPanel Margin="0,10,0,0">
            <Button x:Name="WatchStart" Content="Duell starten" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="WatchPause" Content="Pause" IsEnabled="False"/>
            <Button x:Name="WatchNext" Content="Nächste Aktion" IsEnabled="False"/>
            <Button x:Name="WatchStop" Content="Beenden" IsEnabled="False"/>
            <TextBlock x:Name="WatchState" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
          </WrapPanel>
          <WrapPanel Margin="0,8,0,0">
            <TextBlock x:Name="WatchPhaseDraw" Text="Ziehphase" Style="{StaticResource WatchPhaseChip}"/>
            <TextBlock x:Name="WatchPhaseStandby" Text="Standby" Style="{StaticResource WatchPhaseChip}"/>
            <TextBlock x:Name="WatchPhaseMain1" Text="Main Phase 1" Style="{StaticResource WatchPhaseChip}"/>
            <TextBlock x:Name="WatchPhaseBattle" Text="Kampfphase" Style="{StaticResource WatchPhaseChip}"/>
            <TextBlock x:Name="WatchPhaseMain2" Text="Main Phase 2" Style="{StaticResource WatchPhaseChip}"/>
            <TextBlock x:Name="WatchPhaseEnd" Text="End Phase" Style="{StaticResource WatchPhaseChip}"/>
          </WrapPanel>
          <TextBlock x:Name="WatchError" Margin="0,7,0,0" Foreground="#FFCC90" TextWrapping="Wrap" Visibility="Collapsed" MaxHeight="100"/>
        </StackPanel>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2.75*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Panel}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <WrapPanel Margin="0,0,0,5">
                <TextBlock x:Name="WatchTopName" Text="Deck B" FontSize="15" FontWeight="SemiBold"
                           Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Button x:Name="WatchTopDeck" Content="Deck" IsEnabled="False"/>
                <Button x:Name="WatchTopGrave" Content="Friedhof" IsEnabled="False"/>
                <TextBlock x:Name="WatchTopInfo" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              </WrapPanel>
              <TextBlock x:Name="WatchTopHandLabel" Text="Hand" Style="{StaticResource LabelText}"/>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,5">
                <ItemsControl x:Name="WatchTopHand" ItemTemplate="{StaticResource WatchHandCard}" ItemsPanel="{StaticResource HandSlots}"/>
              </ScrollViewer>
              <TextBlock Text="Zauber- und Fallenzonen" Style="{StaticResource LabelText}"/>
              <ItemsControl x:Name="WatchTopSpells" ItemTemplate="{StaticResource WatchTile}" ItemsPanel="{StaticResource SpellSlots}"/>
              <TextBlock Text="Monsterzonen" Style="{StaticResource LabelText}" Margin="0,5,0,3"/>
              <ItemsControl x:Name="WatchTopMonsters" ItemTemplate="{StaticResource WatchTile}" ItemsPanel="{StaticResource MonsterSlots}"/>
              <Border Height="1" Background="{StaticResource Line}" Margin="0,10"/>
              <TextBlock Text="Monsterzonen" Style="{StaticResource LabelText}"/>
              <ItemsControl x:Name="WatchBottomMonsters" ItemTemplate="{StaticResource WatchTile}" ItemsPanel="{StaticResource MonsterSlots}"/>
              <TextBlock Text="Zauber- und Fallenzonen" Style="{StaticResource LabelText}" Margin="0,5,0,3"/>
              <ItemsControl x:Name="WatchBottomSpells" ItemTemplate="{StaticResource WatchTile}" ItemsPanel="{StaticResource SpellSlots}"/>
              <WrapPanel Margin="0,7,0,5">
                <TextBlock x:Name="WatchBottomName" Text="Deck A" FontSize="15" FontWeight="SemiBold"
                           Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Button x:Name="WatchBottomDeck" Content="Deck" IsEnabled="False"/>
                <Button x:Name="WatchBottomGrave" Content="Friedhof" IsEnabled="False"/>
                <TextBlock x:Name="WatchBottomInfo" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              </WrapPanel>
              <TextBlock x:Name="WatchBottomHandLabel" Text="Hand" Style="{StaticResource LabelText}"/>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="WatchBottomHand" ItemTemplate="{StaticResource WatchHandCard}" ItemsPanel="{StaticResource HandSlots}"/>
              </ScrollViewer>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Panel}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Duellverlauf" Style="{StaticResource SectionTitle}"/>
            <ListBox x:Name="WatchLog" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" x:Name="TrainingPage" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Lokale KI (Qwen)" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="QwenState" Text="Prüfe Qwen …" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
            <Button x:Name="QwenStart" Content="Qwen starten" HorizontalAlignment="Left" Margin="0,0,0,18"/>
            <TextBlock Text="Neues Training" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Deck" Style="{StaticResource LabelText}"/>
            <ComboBox x:Name="TrainDeck" Margin="0,0,0,9" AutomationProperties.Name="Trainingsdeck"/>
            <Grid Margin="0,0,0,9">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Spieler-KIs" Style="{StaticResource LabelText}"/><ComboBox x:Name="TrainPlayers"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Mind. Duelle" Style="{StaticResource LabelText}"/><TextBox x:Name="TrainMinDuels" Text="1000"/></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Text="Zielnote" Style="{StaticResource LabelText}"/><TextBox x:Name="TrainTarget" Text="9"/></StackPanel>
            </Grid>
            <CheckBox x:Name="TrainQwen" IsChecked="True" Foreground="#E6E9F2" Margin="0,0,0,6">
              <TextBlock TextWrapping="Wrap" Text="Mit Qwen: Coach, Zuschauer-Reviewer, Judge-Erklärungen, Deckanalyse"/>
            </CheckBox>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10" LineHeight="19"
                       Text="Die Spieler-KIs spielen Spiegelduelle im Turnier und verbessern ihre Playbooks. Prüfrunden messen den Champion gegen den Referenz-Bot und das Start-Playbook. Das Training endet bei zwei Prüfrunden ab der Zielnote, bei Stillstand oder auf Wunsch."/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="TrainStart" Content="Training starten" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="TrainQueue" Content="Zur Warteschlange"/>
            </StackPanel>
            <TextBlock Text="Combo-Solver (erster Zug)" Style="{StaticResource SectionTitle}" Margin="0,22,0,6"/>
            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19"
                       Text="Spielt für Starthände des gewählten Decks den ersten Zug immer wieder neu und sucht die Linie mit dem stärksten Endboard (Negationen, Quick Effects, Fallen, Handtraps). Der Gegner unterbricht dabei noch nicht."/>
            <TextBlock Text="Starthände" Style="{StaticResource LabelText}"/>
            <TextBox x:Name="SolverHands" Text="30" Margin="0,0,0,6" AutomationProperties.Name="Anzahl Starthände für den Solver"/>
            <TextBlock x:Name="SolverState" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <WrapPanel>
              <Button x:Name="SolverStart" Content="Solver starten"/>
              <Button x:Name="SolverOpen" Content="Linien öffnen" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock Text="Warteschlange" Style="{StaticResource SectionTitle}" Margin="0,22,0,6"/>
            <TextBlock x:Name="QueueState" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Aufträge laufen automatisch nacheinander, auch wenn die App geschlossen ist."/>
            <ListBox x:Name="QueueList" Height="150" Margin="0,0,0,6" AutomationProperties.Name="Warteschlange"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel>
              <Button x:Name="QueueRemove" Content="Entfernen" IsEnabled="False"/>
              <Button x:Name="QueuePause" Content="Anhalten"/>
              <Button x:Name="QueueClear" Content="Erledigte entfernen"/>
            </WrapPanel>
            <TextBlock Text="Obsidian" Style="{StaticResource SectionTitle}" Margin="0,22,0,6"/>
            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19"
                       Text="Alle Fortschritte (Decks, Trainings, Turniere) werden als verlinkte Notizen mit Diagrammen in einen Obsidian-Vault geschrieben, automatisch nach jeder Prüfrunde und jedem Turnier."/>
            <TextBlock Text="Vault-Ordner" Style="{StaticResource LabelText}"/>
            <TextBox x:Name="ObsidianVault" Margin="0,0,0,6" AutomationProperties.Name="Obsidian-Vault-Ordner"/>
            <WrapPanel>
              <Button x:Name="ObsidianSave" Content="Ordner speichern"/>
              <Button x:Name="ObsidianExport" Content="Jetzt aktualisieren"/>
              <Button x:Name="ObsidianOpen" Content="In Obsidian öffnen"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Trainingsläufe" Style="{StaticResource SectionTitle}"/>
          <ListBox Grid.Row="1" x:Name="TrainRuns" AutomationProperties.Name="Trainingsläufe"/>
          <StackPanel Grid.Row="2" Margin="0,12,0,8">
            <TextBlock x:Name="TrainHeadline" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="TrainProgress" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="TrainRatings" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
          <ListBox Grid.Row="3" x:Name="TrainLog" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas" FontSize="12">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="TrainStop" Content="Stoppen" IsEnabled="False"/>
            <Button x:Name="TrainResume" Content="Fortsetzen" IsEnabled="False"/>
            <Button x:Name="TrainReport" Content="Bericht öffnen" IsEnabled="False"/>
            <Button x:Name="TrainFolder" Content="Ordner öffnen" IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="1" x:Name="TournamentPage" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Meta-Feld" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="70"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Deck" Style="{StaticResource LabelText}"/><ComboBox x:Name="YcsDeck" AutomationProperties.Name="Deck für das Feld"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Anteil %" Style="{StaticResource LabelText}"/><TextBox x:Name="YcsShare" Text="10"/></StackPanel>
              <Button Grid.Column="4" x:Name="YcsAdd" Content="Hinzufügen" VerticalAlignment="Bottom" Margin="0"/>
            </Grid>
            <ListBox x:Name="YcsField" Height="190" Margin="0,0,0,6" AutomationProperties.Name="Decks im Feld"/>
            <DockPanel Margin="0,0,0,14">
              <Button x:Name="YcsRemove" Content="Entfernen" IsEnabled="False"/>
              <TextBlock x:Name="YcsShareSum" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <Grid Margin="0,0,0,9">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Spieler" Style="{StaticResource LabelText}"/><TextBox x:Name="YcsPlayers" Text="2500"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Top Cut" Style="{StaticResource LabelText}"/><ComboBox x:Name="YcsCut"/></StackPanel>
            </Grid>
            <TextBlock x:Name="YcsPlan" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <CheckBox x:Name="YcsQwen" IsChecked="True" Foreground="#E6E9F2" Margin="0,0,0,6">
              <TextBlock TextWrapping="Wrap" Text="Mit Qwen: Turnierkommentar im Bericht"/>
            </CheckBox>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10" LineHeight="19"
                       Text="Schweizer System mit Best of 3, danach Top Cut. Jeder Spieler nutzt das trainierte Playbook seines Decks, sonst das neutrale. Side Deck wird noch nicht gewechselt."/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="YcsStart" Content="Turnier starten" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="YcsQueue" Content="Erst Feld trainieren, dann Turnier"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0" LineHeight="19"
                       Text="„Erst Feld trainieren“ stellt für jedes Deck ohne freigegebenes Playbook ein KI-Training (64 KIs, 1.000 Duelle, Ziel 9) und danach das Turnier in die Warteschlange (Reiter KI-Training)."/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Turniere" Style="{StaticResource SectionTitle}"/>
          <ListBox Grid.Row="1" x:Name="YcsRuns" AutomationProperties.Name="Turniere"/>
          <StackPanel Grid.Row="2" Margin="0,12,0,8">
            <TextBlock x:Name="YcsHeadline" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="YcsProgress" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
          <ListBox Grid.Row="3" x:Name="YcsLog" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas" FontSize="12">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="YcsStop" Content="Stoppen" IsEnabled="False"/>
            <Button x:Name="YcsReport" Content="Bericht öffnen" IsEnabled="False"/>
            <Button x:Name="YcsFolder" Content="Ordner öffnen" IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="Status" Margin="0,10,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
  </Grid>
  </Border>
</Window>
